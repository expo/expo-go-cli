{
  "name": "expo-go",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "0.0.4",
  "type": "module",
  "private": false,
  "bin": {
    "expo-go": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./index.ts --target=browser --outfile=dist/index.js && bun build ./cli.ts --target=node --outfile=dist/cli.js && tsc --project tsconfig.build.json",
    "dev": "bun ./cli.ts",
    "test": "bun test src",
    "test:e2e": "bun test e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "memfs": "^4.57.3",
    "multitars": "^1.0.0",
    "typescript": "^5"
  }
}
