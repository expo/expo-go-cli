{
  "name": "expo-go",
  "version": "0.0.5",
  "description": "Download Expo Go binaries or resolve their download URLs from the command line.",
  "keywords": [
    "expo",
    "expo-go",
    "cli",
    "download",
    "ios",
    "android",
    "simulator"
  ],
  "homepage": "https://github.com/expo/expo-go-cli#readme",
  "bugs": {
    "url": "https://github.com/expo/expo-go-cli/issues"
  },
  "license": "MIT",
  "author": "Expo",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo-go-cli.git"
  },
  "module": "dist/index.js",
  "bin": {
    "expo-go": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./index.ts --target=node --outfile=dist/index.js",
    "dev": "bun ./index.ts",
    "test": "bun test src",
    "test:e2e": "bun test e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "memfs": "^4.57.3",
    "multitars": "^1.0.0",
    "typescript": "^5"
  }
}
